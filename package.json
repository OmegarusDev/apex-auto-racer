{
  "name": "apex-auto-racer",
  "private": true,
  "version": "0.1.0",
  "description": "Scalextric-style pedal autobattler — groove/deslot physics, assisted gears, career garage.",
  "homepage": "https://omegarusdev.github.io/apex-auto-racer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmegarusDev/apex-auto-racer.git"
  },
  "bugs": {
    "url": "https://github.com/OmegarusDev/apex-auto-racer/issues"
  },
  "license": "MIT",
  "author": "OmegarusDev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "play": "vite --host 127.0.0.1 --port 5173 --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "validate": "npm run validate:feel",
    "validate:feel": "vite-node scripts/feel-contract.ts",
    "validate:intent": "vite-node scripts/intent-validate.ts",
    "validate:meta": "vite-node scripts/meta-validate.ts",
    "validate:start": "vite-node scripts/start-validate.ts",
    "validate:slot": "vite-node scripts/scalextric-validate.ts",
    "validate:pack": "vite-node scripts/collision-validate.ts",
    "validate:field": "vite-node scripts/field-validate.ts",
    "validate:smoke": "vite-node scripts/smoke.ts",
    "validate:stack": "vite-node scripts/stack-smoke.ts",
    "validate:title": "vite-node scripts/title-layout-smoke.ts"
  },
  "devDependencies": {
    "terser": "^5.49.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0"
  }
}
